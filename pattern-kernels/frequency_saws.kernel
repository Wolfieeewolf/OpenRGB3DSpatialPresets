# Name
name: Frequency saws
index: 44
palette: frequency

# Kernel
float a = fractf(s01 * r * 2.0 + tsec * 0.18 + ph);
float b = fractf(s01 * r * 3.5 - tsec * 0.11 + ph * 1.3);
float c = fractf(s01 * r * 5.0 + tsec * 0.07 + ph * 0.6);
k = clamp((a * 0.55 + b * 0.30 + c * 0.15) * 2.0 - 1.0, -1.0, 1.0);
