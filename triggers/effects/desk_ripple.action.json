// =============================================================================
// Effect pack — desk_ripple  (example multi-track / device targets)
// Layout follows timelines/_template.action.json
// =============================================================================
{
  // --- Pack identity ---------------------------------------------------------
  "format": "openrgb3d.action",
  "version": 4,
  "id": "desk_ripple",
  "name": "Desk ripple",

  // --- Playback --------------------------------------------------------------
  "duration_ms": 5000,
  "loop": "once",
  "priority": 20,

  // --- Tracks ----------------------------------------------------------------
  "tracks": [
    {
      "name": "All LEDs",
      "target": { "kind": "all" },
      "clips": []
    },
    {
      "name": "Fan 2",
      "target": {
        "kind": "zone",
        "device_name": "Intel Arc A770 Limited Edition",
        "zone_name": "Fan 2"
      },
      "clips": [
        {
          // --- Clip look / type ---------------------------------------------
          "type": "solid",
          "effect": "solid",

          // --- Timing within the pack ----------------------------------------
          "start_ms": 0,
          "end_ms": 880,

          // --- Brightness ----------------------------------------------------
          "intensity": 1.0,
          "min_intensity": 0.15,
          "max_intensity": 1.0,

          // --- Colour --------------------------------------------------------
          "color": "#FFFFFF",
          "color_from": "#FFFFFF",
          "color_to": "#FFFFFF",
          "gradient": [
            { "pos": 0.0, "color": "#FFFFFF" },
            { "pos": 1.0, "color": "#FFFFFF" }
          ],

          // --- Motion / space ------------------------------------------------
          "direction": "right",
          "axis_space": "device",
          "axis_mode": "preset",
          "axis_yaw_deg": 0.0,
          "axis_pitch_deg": 0.0,
          "speed": 1.0,
          "pulse_length": 0.25,
          "period_ms": 800,
          "reverse": false
        }
      ]
    },
    {
      "name": "PC LED Stick",
      "target": {
        "kind": "device",
        "device_name": "PC LED Stick"
      },
      "clips": []
    },
    {
      "name": "PC LED Stick",
      "target": {
        "kind": "zone",
        "device_name": "PC LED Stick",
        "zone_name": "PC LED Stick"
      },
      "clips": [
        {
          // --- Clip look / type ---------------------------------------------
          "type": "ripple",
          "effect": "ripple",

          // --- Timing within the pack ----------------------------------------
          "start_ms": 10,
          "end_ms": 5000,

          // --- Brightness ----------------------------------------------------
          "intensity": 1.0,
          "min_intensity": 0.15,
          "max_intensity": 1.0,

          // --- Colour --------------------------------------------------------
          "color": "#FF0000",
          "color_from": "#FF0000",
          "color_to": "#8000FF",
          "gradient": [
            { "pos": 0.0, "color": "#FF0000" },
            { "pos": 0.2, "color": "#FF8000" },
            { "pos": 0.4, "color": "#FFFF00" },
            { "pos": 0.6, "color": "#00FF00" },
            { "pos": 0.8, "color": "#0080FF" },
            { "pos": 1.0, "color": "#8000FF" }
          ],

          // --- Motion / space ------------------------------------------------
          "direction": "right",
          "axis_space": "room",
          "axis_mode": "preset",
          "axis_yaw_deg": 0.0,
          "axis_pitch_deg": 0.0,
          "speed": 1.0,
          "pulse_length": 0.18,
          "period_ms": 1000,
          "reverse": false
        }
      ]
    }
  ]
}
