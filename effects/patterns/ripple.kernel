# Name
name: Ripple (from center)
index: 38

# Kernel
float d = abs(s01 - 0.5) * 2.0;
float travel = fractf(ph + tsec * 0.28);
float wave = sin(TWO_PI * (2.4 * d - travel * 2.0));
float envelope = 1.0 - smstep(0.0, 1.05, d);
float crest = pow(max(0.0, 0.5 + 0.5 * wave), 2.4);
k = clamp((crest * envelope) * 2.0 - 1.0, -1.0, 1.0);
