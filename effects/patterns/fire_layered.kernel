# Name
name: Fire (layered heat)
index: 20
palette: fire

# Kernel
float heat = 0.0;
for(int o = 0; o < 4; o++)
{
    float f = pow(2.0, float(o));
    float drift = tsec * (0.07 + 0.035 * float(o));
    heat += sin(TWO_PI * (s01 * r * f * 0.34 + ph + drift)) / f;
    heat += 0.22 * sin(TWO_PI * (s01 * r * f * 0.71 - drift * 1.3 + ph * 0.5)) / f;
}
float tip = pow(max(0.0, 0.55 + 0.45 * heat), 1.8);
float base = 0.35 + 0.65 * smstep(-0.4, 0.85, heat);
k = clamp(tanh((base * tip) * 1.55) * 2.0 - 1.0, -1.0, 1.0);
