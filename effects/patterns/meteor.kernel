# Name
name: Meteor (head + tail)
index: 43
palette: meteor

# Kernel
float pos = fractf(tsec * (0.16 + 0.07 * hash11(ph * 3.1 + 0.2)) + ph * 0.35);
float u = fractf(s01 * r - pos + 1.0);
float head = smstep(0.0, 0.022, u) * (1.0 - smstep(0.022, 0.048, u));
float tail = max(0.0, 1.0 - u * 4.2);
tail = pow(tail, 1.65) * 0.95;
float spark = hash11(floor(u * 48.0) + ph * 9.0) * smstep(0.05, 0.55, u) * 0.18;
k = clamp(max(head * 1.15, tail) + spark * 2.0 - 1.0, -1.0, 1.0);
