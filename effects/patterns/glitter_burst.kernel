# Name
name: Glitter burst
index: 18
palette: sparkle

# Kernel
float t = s01 * r * 36.0 + tsec * 7.5 + ph * 4.0;
float cell = floor(t);
float tw = fractf(t);
float h = hash11(cell * 0.07 + 2.3);
float on = step(0.90, h);
float burst = on * pow(max(0.0, 1.0 - tw * 3.4), 1.4);
float dust = step(0.97, hash11(cell * 0.19)) * (1.0 - tw) * 0.25;
k = clamp((burst + dust) * 2.0 - 1.0, -1.0, 1.0);
