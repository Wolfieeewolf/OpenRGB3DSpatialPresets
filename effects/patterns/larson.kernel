# Name
name: Oscillating sweep
index: 15

# Kernel
float sweep = 0.5 + 0.5 * sin(TWO_PI * (ph * 0.5 + tsec * 0.11));
float d = abs(fractf(s01 * r) - sweep);
d = min(d, 1.0 - d);
float core = 1.0 - smstep(0.0, 0.045, d);
float halo = 1.0 - smstep(0.0, 0.14, d);
k = clamp((core * 1.1 + halo * 0.45) * 2.0 - 1.0, -1.0, 1.0);
