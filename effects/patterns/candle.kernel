# Name
name: Candle (soft warm flicker)
index: 42
palette: candle

# Kernel
float t = s01 * r * 1.6 + tsec * 0.14;
float i = floor(t);
float f = t - i;
float n0 = hash11(i + 1.1);
float n1 = hash11(i + 2.1);
float s = f * f * (3.0 - 2.0 * f);
float smooth_n = n0 + (n1 - n0) * s;
float breathe = 0.55 + 0.45 * sin(TWO_PI * (tsec * 0.19 + s01 * r * 0.06));
float micro = (hash11(floor(tsec * 9.0) + s01 * r * 11.0) - 0.5) * 0.10;
float v = 0.62 + 0.28 * smooth_n * breathe + micro;
k = clamp(v * 2.0 - 1.0, -1.0, 1.0);
