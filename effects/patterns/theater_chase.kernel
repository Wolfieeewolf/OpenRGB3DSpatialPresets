# Name
name: Multi-slot chase
index: 13
palette: chase

# Kernel
float slots = 3.0;
float phase = fractf(tsec * 0.35 + ph * 0.2);
float idx = floor(s01 * r * 18.0 + phase * slots);
float bucket = mod(idx, slots);
float lit = 1.0 - step(0.5, bucket);
float edge = smstep(0.0, 0.15, fractf(s01 * r * 18.0));
k = clamp((lit * (0.75 + 0.25 * edge)) * 2.0 - 1.0, -1.0, 1.0);
